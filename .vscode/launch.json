{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "BE: Flask (HTTP)",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_DEBUG": "1"
            },
            "preLaunchTask": "Init Collectify DB Tables",
            "args": [
                "run",
                // "--no-debugger",
                // "--no-reload"
            ],
            "jinja": true,
            "cwd": "${workspaceFolder}/backend",
            "justMyCode": false,
        },
        {
            "name": "BE: Flask (HTTPS)",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_DEBUG": "1",
                "SSL_CERT_FILE": "${workspaceFolder}/certificates/server.crt",
                "SSL_KEY_FILE": "${workspaceFolder}/certificates/server.key",
                "FLASK_HTTPS": "1"
            },
            "preLaunchTask": "Init Collectify DB Tables",
            "args": [
                "run",
                "--cert=adhoc"
                // "--no-debugger",
                // "--no-reload"
            ],
            "jinja": true,
            "cwd": "${workspaceFolder}/backend",
            "justMyCode": false,
        },
        {
            "name": "Chrome (HTTP)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMaps": true,
            "trace": true,
            "runtimeArgs": [
                "--remote-debugging-port=9222"
            ],
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/src/*",
                "webpack:///node_modules/*": "${webRoot}/node_modules/*",
                "webpack:///*": "*"
            }
        },
        {
            "name": "Chrome (HTTPS)",
            "type": "chrome",
            "request": "launch",
            "url": "https://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMaps": true,
            "trace": true,
            "runtimeArgs": [
                "--remote-debugging-port=9222",
                "--ignore-certificate-errors"
            ],
            "sourceMapPathOverrides": {
                "webpack:///src/*": "${webRoot}/src/*",
                "webpack:///node_modules/*": "${webRoot}/node_modules/*",
                "webpack:///*": "*"
            }
        }
    ],
    "compounds": [
        {
            "name": "Full Stack (HTTP)",
            "configurations": ["BE: Flask (HTTP)", "Chrome (HTTP)"]
        },
        {
            "name": "Full Stack (HTTPS)",
            "configurations": ["BE: Flask (HTTPS)", "Chrome (HTTPS)"]
        }
    ]
}